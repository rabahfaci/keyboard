#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define NUM 1
#define NAV 2
#define FUN 3
#define CMD 4
#define DEFAULT_WIN 5
#define CMD_WIN 6
#define FR 7

# define ______ &trans

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUM NAV>;
            then-layer = <FUN>;
        };
        accents_layer {
            if-layers = <CMD NAV>;
            then-layer = <FR>;
        };
    };
    combos {
        compatible = "zmk,combos";
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <30 31>;
            bindings = <&studio_unlock>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_enter {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&kp RET>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_escape {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp ESC>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        /* Shift (D3) + G3 locks Shift on; the same gesture releases it. */
        combo_shift_lock {
            timeout-ms = <40>;
            key-positions = <30 35>;
            bindings = <&kt LSHFT>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        /* Accent combos on adjacent home-row letters, so accents never require
         * leaving the base layer: N+E = e-acute, E+I = e-grave. */
        combo_eacute {
            timeout-ms = <40>;
            key-positions = <16 17>;
            bindings = <&eacute_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_egrave {
            timeout-ms = <40>;
            key-positions = <17 18>;
            bindings = <&egrave_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_agrave {
            timeout-ms = <40>;
            key-positions = <13 14>;
            bindings = <&agrave_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_ccedil {
            timeout-ms = <40>;
            key-positions = <13 22>;
            bindings = <&ccedil_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_acirc {
            timeout-ms = <40>;
            key-positions = <14 24>;
            bindings = <&acirc_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_ecirc {
            timeout-ms = <40>;
            key-positions = <17 7>;
            bindings = <&ecirc_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_icirc {
            timeout-ms = <40>;
            key-positions = <18 8>;
            bindings = <&icirc_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_ocirc {
            timeout-ms = <40>;
            key-positions = <15 25>;
            bindings = <&ocirc_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_ucirc {
            timeout-ms = <40>;
            key-positions = <7 27>;
            bindings = <&ucirc_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_ugrave {
            timeout-ms = <40>;
            key-positions = <7 8>;
            bindings = <&ugrave_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_euml {
            timeout-ms = <40>;
            key-positions = <17 27>;
            bindings = <&euml_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_iuml {
            timeout-ms = <40>;
            key-positions = <18 28>;
            bindings = <&iuml_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_uuml {
            timeout-ms = <40>;
            key-positions = <7 6>;
            bindings = <&uuml_case>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
        combo_delete_forward {
            timeout-ms = <50>;
            key-positions = <32 35>;
            bindings = <&kp DEL>;
            layers = <DEFAULT DEFAULT_WIN>;
        };
    };
    behaviors {
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };
        super_bspc: super_backspace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp LA(BACKSPACE)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        smart_shft: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };
        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT)>;
        };
        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT)>;
        };
        qmrk_excl: qmrk_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp EXCL>;
            mods = <(MOD_LSFT)>;
        };
        slh_morph: slh_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;
            mods = <(MOD_LSFT)>;
        };
        amps_morph: amps_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AMPS>, <&kp PIPE>;
            mods = <(MOD_LSFT)>;
        };
        quote_morph: quote_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DQT>, <&kp APOS>;
            mods = <(MOD_LSFT)>;
        };
        /* Custom per-key Shift behaviors from the visual editor. */
        custom_default_j1_morph: custom_default_j1_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        custom_default_j2_morph: custom_default_j2_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp RPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        custom_default_i3_morph: custom_default_i3_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        /* Thumb layer keys that also hold an unused F-key (F17-F19, inert on macOS),
         * so the host-side screen preview can see which layer thumb is held. */
        mo_num_sig: mo_num_sig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo NUM &kp F17>, <&macro_pause_for_release>, <&macro_release &mo NUM &kp F17>;
        };
        mo_nav_sig: mo_nav_sig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo NAV &kp F18>, <&macro_pause_for_release>, <&macro_release &mo NAV &kp F18>;
        };
        mo_cmd_sig: mo_cmd_sig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo CMD &kp F19>, <&macro_pause_for_release>, <&macro_release &mo CMD &kp F19>;
        };
        mo_cmd_win_sig: mo_cmd_win_sig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo CMD_WIN &kp F19>, <&macro_pause_for_release>, <&macro_release &mo CMD_WIN &kp F19>;
        };
        /* French accents: macOS Option dead-key sequences (Option+E, E = é / Option+`, E = è).
         * Mac-mode only -- Alt means something else entirely on Windows/Linux. */
        fr_eacute_macro: fr_eacute_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(E) &kp E>;
        };
        fr_egrave_macro: fr_egrave_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE) &kp E>;
        };
        fr_agrave: fr_agrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE) &kp A>;
        };
        /* Uppercase variants: same dead-key sequence, Shift held on the letter tap. */
        fr_eacute_upper_macro: fr_eacute_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(E) &kp LS(E)>;
        };
        fr_egrave_upper_macro: fr_egrave_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE) &kp LS(E)>;
        };
        fr_agrave_upper_macro: fr_agrave_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE) &kp LS(A)>;
        };
        /* Case-aware wrappers bound directly to the combos below. */
        eacute_case: eacute_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_eacute_macro>, <&fr_eacute_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        egrave_case: egrave_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_egrave_macro>, <&fr_egrave_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        agrave_case: agrave_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_agrave>, <&fr_agrave_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ccedil_case: ccedil_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(C)>, <&kp LA(LS(C))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        /* Remaining French accents, lowercase only -- rare enough (<0.25% each)
         * that a Shift-case variant isn't worth the extra behavior. */
        fr_acirc: fr_acirc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp A>;
        };
        fr_ecirc: fr_ecirc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp E>;
        };
        fr_icirc: fr_icirc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp I>;
        };
        fr_ocirc: fr_ocirc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp O>;
        };
        fr_ucirc: fr_ucirc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp U>;
        };
        fr_ugrave: fr_ugrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE) &kp U>;
        };
        fr_euml: fr_euml {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U) &kp E>;
        };
        fr_iuml: fr_iuml {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U) &kp I>;
        };
        fr_uuml: fr_uuml {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U) &kp U>;
        };
        /* Uppercase variants + case-aware wrappers for the 9 rare accents above. */
        fr_acirc_upper_macro: fr_acirc_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp LS(A)>;
        };
        fr_ecirc_upper_macro: fr_ecirc_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp LS(E)>;
        };
        fr_icirc_upper_macro: fr_icirc_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp LS(I)>;
        };
        fr_ocirc_upper_macro: fr_ocirc_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp LS(O)>;
        };
        fr_ucirc_upper_macro: fr_ucirc_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I) &kp LS(U)>;
        };
        fr_ugrave_upper_macro: fr_ugrave_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE) &kp LS(U)>;
        };
        fr_euml_upper_macro: fr_euml_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U) &kp LS(E)>;
        };
        fr_iuml_upper_macro: fr_iuml_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U) &kp LS(I)>;
        };
        fr_uuml_upper_macro: fr_uuml_upper_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U) &kp LS(U)>;
        };
        acirc_case: acirc_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_acirc>, <&fr_acirc_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ecirc_case: ecirc_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_ecirc>, <&fr_ecirc_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        icirc_case: icirc_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_icirc>, <&fr_icirc_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ocirc_case: ocirc_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_ocirc>, <&fr_ocirc_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ucirc_case: ucirc_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_ucirc>, <&fr_ucirc_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ugrave_case: ugrave_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_ugrave>, <&fr_ugrave_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        euml_case: euml_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_euml>, <&fr_euml_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        iuml_case: iuml_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_iuml>, <&fr_iuml_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        uuml_case: uuml_case {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&fr_uuml>, <&fr_uuml_upper_macro>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp Q         &kp W         &kp F         &kp P         &kp B             &kp J         &kp L         &kp U         &kp Y       &custom_default_j1_morph
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp G         &kp R         &kp S         &kp T         &kp A             &kp O         &kp N         &kp E         &kp I         &custom_default_j2_morph
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp Z         &kp X         &kp C         &kp D         &kp V             &kp K         &kp H         &kp M    &custom_default_i3_morph    &qmrk_excl
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &mo_cmd_sig       &mo_num_sig       &kp BSPC         &kp SPACE      &mo_nav_sig     &kp LSHFT
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };
                num_layer {
                        bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp TILDE       &kp AT       &kp LBRC      &kp RBRC     &kp PRCNT          &kp STAR       &kp N7        &kp N8        &kp N9      &kp MINUS
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp CARET      &kp HASH      &kp LPAR      &kp RPAR      &kp DLLR         &kp UNDER       &kp N4        &kp N5        &kp N6      &kp PLUS
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &amps_morph     &kp LT       &kp LBKT      &kp RBKT       &kp GT          &slh_morph      &kp N1        &kp N2        &kp N3      &kp EQUAL
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        ______        ______            &kp N0        ______        ______
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                nav_layer {
                        bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        ______        ______        ______        ______        ______           &kp DEL       &kp HOME      &kp END       &kp TAB       &kp BSPC
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &sk LSHFT     &sk LCTRL      &sk LALT      &sk LGUI       ______           &kp LEFT      &kp DOWN       &kp UP      &kp RIGHT       &gresc
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ______        ______        ______        ______        ______            ______        &kp RET       ______        ______        ______
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        ______        ______            ______        ______        ______
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                fun_layer {
                        bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      ______      &kp K_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &out OUT_USB    &to DEFAULT_WIN   &kp F7        &kp F8        &kp F9       &kp F12
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &to DEFAULT     &kp F4        &kp F5        &kp F6       &kp F11
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &bt BT_CLR    &kp C_PREV     &kp C_PP     &kp C_NEXT   &out OUT_BLE    &bt BT_CLR_ALL   &kp F1        &kp F2        &kp F3       &kp F10
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        ______        ______            ______        ______        ______
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                cmd_layer {
                        bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
       &kp LG(Q)    &kp LG(W)       &kp F       &kp LG(P)       &kp B          &kp LC(LEFT)   &kp LC(RIGHT)   &kp LC(UP)    &kp LC(DOWN)  &kp LG(SPACE)
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &kp LSHFT    &kp LCTRL     &kp LALT      &kp LGUI      &kp LG(G)          &kp LG(TAB)     ______        ______        ______        ______
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &kp LG(Z)    &kp LG(X)     &kp LG(C)       &kp D       &kp LG(V)           ______        ______        ______        ______        ______
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        ______        ______            ______        ______        ______
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                default_win_layer {
                        bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp Q         &kp W         &kp F         &kp P         &kp B             &kp J         &kp L         &kp U         &kp Y       &quote_morph
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp G         &kp R         &kp S         &kp T         &kp A             &kp O         &kp N         &kp E         &kp I         &kp M
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp Z         &kp X         &kp C         &kp D         &kp V             &kp K         &kp H      &comma_semi    &dot_colon    &qmrk_excl
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                 &mo_cmd_win_sig     &mo_num_sig       &kp BSPC         &kp SPACE      &mo_nav_sig     &kp LSHFT
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                cmd_win_layer {
                        bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
       &kp LC(Q)    &kp LC(W)       &kp F       &kp LC(P)       &kp B             ______        ______        ______        ______        ______
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &kp LSHFT    &kp LCTRL     &kp LALT      &kp LGUI      &kp LC(G)           ______        ______        ______        ______        ______
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &kp LC(Z)    &kp LC(X)     &kp LC(C)       &kp D       &kp LC(V)           ______        ______        ______        ______        ______
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        ______        ______            ______        ______        ______
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                /* French accents (macOS Option dead-keys). Mirrors letter
                 * positions for muscle memory: à under A, é/è under E, ç under C. */
                fr_layer {
                        bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        ______        ______        ______        ______        ______            ______        ______        ______        ______        ______
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ______        ______        ______        ______      &fr_agrave          ______        ______     &fr_eacute_macro     ______        ______
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ______        ______      &kp LA(C)       ______        ______            ______        ______        ______        ______        ______
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        ______        ______            ______        ______        ______
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };
        };
};
